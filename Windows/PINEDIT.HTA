<html>
<head>
<title>Matrox PIN Generator</title>
<HTA:APPLICATION ID="PinGen" APPLICATIONNAME="MatroxPinGenerator" BORDER="thick"
  CAPTION="yes" SHOWINTASKBAR="yes" SINGLEINSTANCE="no" SYSMENU="yes"
  WINDOWSTATE="normal" SCROLL="yes" INNERBORDER="no" />
<meta http-equiv="content-type" content="text/html; charset=windows-1252">
<style type="text/css">
body { font-family: Tahoma, Verdana, Arial, sans-serif; font-size: 9pt; margin: 0; background: #ECE9D8; color: #000; }
#bar { background: #D4D0C8; border-bottom: 1px solid #808080; padding: 8px 10px; }
#bar select { font-family: Tahoma, Arial; font-size: 10pt; }
#bar b { font-size: 10pt; }
#cardinfo { padding: 6px 10px; background: #FFFFE8; border-bottom: 1px solid #A0A0A0; }
#main { padding: 8px 10px; }
h3 { font-size: 10pt; margin: 12px 0 4px 0; color: #003070; }
table.grid { border-collapse: collapse; background: #FFFFFF; width: 100%; }
table.grid th { background: #D4D0C8; border: 1px solid #A0A0A0; padding: 3px 6px; text-align: left; }
table.grid td { border: 1px solid #C8C8C8; padding: 3px 6px; vertical-align: top; }
td.no { text-align: right; color: #555; width: 22px; }
td.lbl { width: 190px; }
td.lbl span { color: #666; font-size: 8pt; }
input.v, select.v { font-family: "Courier New", monospace; font-size: 9pt; }
input.v { width: 190px; }
.fixed { font-family: "Courier New", monospace; color: #555; }
tr.chg td { background: #FFF3C0; }
tr.bad td { background: #FFD8D8; }
.hint { color: #305080; font-size: 8pt; }
.warn { color: #A05000; font-size: 8pt; }
.err { color: #C00000; font-weight: bold; font-size: 8pt; }
#savebox { background: #FFFFFF; border: 1px solid #A0A0A0; padding: 8px; margin-top: 12px; }
#savebox input.path { font-family: Tahoma, Arial; font-size: 9pt; width: 280px; }
#preview { font-family: "Courier New", monospace; font-size: 9pt; width: 100%; height: 230px; }
#status { padding: 4px 10px; background: #D4D0C8; border-top: 1px solid #808080; }
code { font-family: "Courier New", monospace; background: #EEE; padding: 0 3px; }
</style>

